{
  "llm_provider": "anthropic",
  "ollama_host": "http://localhost:11434",
  "judge_model": "llama3.2",
  "responder_model": "mistral",
  "anthropic_model": "claude-sonnet-4-6",
  "anthropic_judge_model": "claude-haiku-4-5-20251001",
  "openai_model": "gpt-4o",
  "temperature": 0.82,
  "max_tokens": 16384,
  "judge_temp": 0.05,
  "self_eval_enabled": true,
  "self_eval_threshold": 0.40,
  "show_reasoning": false,
  "memory_summary_every": 16,
  "profile_update_every": 4,
  "harm_penalty_scale": 0.15,
  "distress_threshold": 0.65,
  "tools_enabled": true,
  "sycophancy_probe_enabled": false,
  "search_max_chars": 2400,
  "web_host": "0.0.0.0",
  "web_port": 8000,
  "rate_limit_per_minute": 120,
  "max_retries": 4,
  "retry_backoff": 1.5,
  "circuit_open_after": 4,
  "proactive_interval_minutes": 0,
  "db_path": "symbion.db",
  "log_path": "symbion_transparency.log",
  "fallback_chain": [
    "anthropic",
    "openai"
  ],
  "mcp_enabled": true,
  "mcp_servers": [
    {
      "name": "time",
      "command": ".python\\python.exe",
      "args": ["-m", "mcp_server_time"],
      "enabled": true
    }
  ]
}