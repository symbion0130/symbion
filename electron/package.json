{
  "name": "symbion-app",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Symbion. Spawns python -m symbion --web in the background and loads the web UI in a native window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.symbion0130.symbion",
    "productName": "Symbion",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../.python",
        "to": ".python",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/tests/**",
          "!**/test/**"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/symbion.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "icon": "assets/symbion.icns"
    },
    "linux": {
      "icon": "assets/symbion-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/symbion.ico",
      "uninstallerIcon": "assets/symbion.ico"
    }
  }
}
