# Environment
.env
*.txt
venv/
__pycache__/
*.pyc

# Data files
*.db
*.db.bak
*.db-shm
*.db-wal
*.log
*.jsonl

# IDE / tools
.claude/
.pytest_cache/

# Portable Python install — created by scripts\bootstrap-portable.bat,
# machine-arch-specific (~100MB), should never be committed
.python/

# Editable install artifact — pip creates this from pyproject.toml
*.egg-info/

# Stray launcher logs from Start-Process redirects
.start.log
.start.err

# Archived legacy code, snapshots, plans (kept locally for diffing only)
archive/

# Personal historical archives (referenced by some evals; local-only)
Model9/

# Web UI image paste cache — written by the WS handler, scrubbed per-session
_pastes/
